{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubproj.dev/schemas/calibration-profile-v2.json",
  "title": "Validated alignment calibration profile",
  "type": "object",
  "required": ["schema", "status", "authority", "profile_id", "identity", "thresholds", "calibrators", "dataset", "metrics", "provenance"],
  "properties": {
    "schema": {"const": "generic-dubbing-alignment-calibration-profile-v2"},
    "status": {"const": "VALIDATED"},
    "authority": {"const": true},
    "profile_id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "required": ["backend_id", "model_id", "model_revision", "feature_schema_version", "target_language", "source_language", "performance_modes"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "feature_schema_version": {"const": "char-alignment-v2"},
        "target_language": {"type": "string", "minLength": 1},
        "source_language": {"type": "string", "minLength": 1},
        "performance_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "thresholds": {
      "type": "object",
      "required": ["target_pass_probability", "target_failure_probability", "final_anchor_pass_probability", "source_lid_probability"],
      "properties": {
        "target_pass_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "target_failure_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "final_anchor_pass_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "source_lid_probability": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "calibrators": {
      "type": "object",
      "required": ["target", "final_anchor"],
      "properties": {
        "target": {"$ref": "#/$defs/calibrator"},
        "final_anchor": {"$ref": "#/$defs/finalAnchorCalibrator"},
        "language_id": {"$ref": "#/$defs/calibrator"}
      },
      "additionalProperties": false
    },
    "calibrator": {"deprecated": true},
    "$defs": {
      "calibrator": {
        "type": "object",
        "required": ["type", "engine", "format", "feature_schema_version", "normalization_version", "artifact_path", "artifact_sha256", "feature_names"],
        "properties": {
        "type": {"const": "platt"},
        "engine": {"const": "builtin"},
        "format": {"const": "json"},
        "feature_schema_version": {"const": "char-alignment-v2"},
        "normalization_version": {"const": "alignment-text-normalization-v1"},
        "artifact_path": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "feature_names": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      },
      "finalAnchorCalibrator": {
        "allOf": [{"$ref": "#/$defs/calibrator"}],
        "properties": {"feature_schema_version": {"const": "final-anchor-v1"}}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["manifest_sha256", "labels_sha256", "split_manifest_sha256", "calibration_count", "validation_count", "hidden_test_count"],
      "additionalProperties": true
    },
    "metrics": {"type": "object", "required": ["hidden_false_pass_count", "hidden_false_fail_count", "brier_score", "expected_calibration_error"], "additionalProperties": true},
    "provenance": {
      "type": "object",
      "required": ["code_commit", "runtime_lock_sha256", "models_lock_sha256", "created_at"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
