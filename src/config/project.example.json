{
  "project_root": "../project",
  "source_language": "en",
  "target_language": "de",
  "topology_default": "LINE_SEPARATED",
  "output_root": "../sandbox/runs",
  "cache_root": "../sandbox/cache_v2",
  "model_id": "k2-fsa/OmniVoice",
  "model_revision": "unknown",
  "backend_version": "unknown",
  "runtime_lock": "runtime.lock.json",
  "models_lock": "models.lock.json",
  "capabilities": {
    "generation": {"enabled": true, "requires": ["omnivoice", "pytorch", "torchaudio"]},
    "asr_screening": {"enabled": true, "requires": ["faster_whisper", "ctranslate2"]},
    "ctc_alignment": {"enabled": true, "requires": ["whisperx"]},
    "independent_lid": {"enabled": false, "requires": ["speechbrain"]},
    "mfa_fallback": {"enabled": false, "requires": ["mfa"]}
  },
  "device": "cuda",
  "dtype": "float16",
  "generation_steps": 32,
  "guidance_scale": 2.0,
  "initial_takes": 1,
  "retry_takes": 0,
  "fmv_initial_takes": 4,
  "fmv_retry_takes": 4,
  "append_ellipsis_experiment": true,
  "sample_rate": 48000,
  "dialogue_channel": 0,
  "ffmpeg": null,
  "vgmstream": null,
  "vgaudio": null,
  "runtime_root": null,
  "sandbox_root": "../sandbox",
  "lab_mode": true,
  "runtime_adapter": null,
  "reference_root": "../references",
  "qa": {
    "hard_gates": ["not_empty", "source_language", "tail", "final_word", "content", "splice_seam", "splice_boundary", "splice_speech_timing", "lufs", "clipping", "frames"],
    "diagnostic_metrics": ["text", "wer", "onset", "span", "rate", "pause", "pitch_identity"],
    "final_word_min_tokens": 1,
    "tail_guard_ms": 80.0,
    "max_lufs_delta": 3.5,
    "max_splice_speech_onset_error_ms": 60.0,
    "max_seam_notch_db": 12.0,
    "english_markers": ["the", "you", "what", "why", "yes", "no", "not", "are", "is", "can", "will", "this", "that", "your", "to", "of", "and"],
    "strong_source_words": []
  }
}
